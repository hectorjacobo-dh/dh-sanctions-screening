# Copy to .env and fill in. Never commit the real .env.

# --- Security (REQUIRED before any non-localhost deployment) ---------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First-run administrator. Leave the password blank to have a strong one
# generated and printed once to the server log at first startup.
BOOTSTRAP_ADMIN_EMAIL=compliance.admin@deliveryhero.com
BOOTSTRAP_ADMIN_PASSWORD=

# Origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence -----------------------------------------------------------
# SQLite is fine for a single-analyst local run. Use PostgreSQL for any shared
# deployment — SQLite will not hold up under concurrent screening runs.
# DATABASE_URL=postgresql+psycopg://screening:CHANGE_ME@db:5432/screening

# --- Matching calibration --------------------------------------------------
MATCH_THRESHOLD=80
STRONG_MATCH_THRESHOLD=95
GEO_CONTRADICTION_PENALTY=15
MAX_CANDIDATES_PER_NAME=400

# --- Watchlist refresh -----------------------------------------------------
REFRESH_CRON_HOUR=3
REFRESH_CRON_MINUTE=15
REFRESH_ON_STARTUP=false
HTTP_TIMEOUT_SECONDS=180

# --- Regulator endpoints ---------------------------------------------------
# All five verified live on 2026-09-09. Regulators do move these — the
# dashboard turns a source red on failure, and the app falls back to a manually
# downloaded file in ./data (see README) so a moved URL cannot silently
# disable a control.
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.csv
OFAC_CONS_URL=https://www.treasury.gov/ofac/downloads/consolidated/cons_prim.csv
EU_FSF_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/csvFullSanctionsList/content?token=dG9rZW4tMjAxNw
# OFSI ConList closed 28 Jan 2026; the FCDO UK Sanctions List is now the sole UK source.
UK_OFSI_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.csv
# scsanctions.un.org now 404s; this is the current UN blob endpoint.
UN_CONSOLIDATED_URL=https://unsolprodfiles.blob.core.windows.net/publiclegacyxmlfiles/EN/consolidated.xml
