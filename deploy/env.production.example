# Production configuration.
#
# Copy to .env and fill in EVERY value. Never commit the filled-in file.
# Anything marked REQUIRED has no safe default.

# --- Security: set these before anyone else can reach the service -----------

# REQUIRED. With this left true there is NO login at all and anyone who can
# reach the port has full admin. Only ever true on a loopback-bound laptop.
SINGLE_USER_MODE=false

# REQUIRED. Signs session tokens; the built-in default is a public placeholder.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Created on first start, password printed to the log once. Use a real address.
BOOTSTRAP_ADMIN_EMAIL=compliance.sanctions@deliveryhero.com
BOOTSTRAP_ADMIN_PASSWORD=

# Origins allowed to call the API. Behind a same-origin proxy this can stay empty.
CORS_ORIGINS=https://sanctions-screening.internal.deliveryhero.com

# --- Persistence ------------------------------------------------------------

# REQUIRED in production. SQLite is single-writer and file-based.
#   Cloud SQL via socket: postgresql+psycopg://USER:PASS@/screening?host=/cloudsql/PROJECT:REGION:INSTANCE
#   Plain host:           postgresql+psycopg://USER:PASS@db:5432/screening
DATABASE_URL=

# Evidence documents.
#   local -> data/evidence   (workstation, or a VM with a persistent volume)
#   gcs   -> a bucket        (REQUIRED on Cloud Run and any ephemeral filesystem,
#                             where local files vanish on restart/scale-to-zero)
EVIDENCE_BACKEND=gcs
EVIDENCE_BUCKET=
EVIDENCE_PREFIX=evidence

# --- Locale -----------------------------------------------------------------

# Display and the human-readable report columns. Storage and the audit hash
# chain stay UTC regardless — local time shifts twice a year and cannot anchor
# an audit trail.
DISPLAY_TIMEZONE=Europe/Berlin

# --- Watchlist refresh ------------------------------------------------------

# Daily cron inside the app. On a scale-to-zero service this never fires
# (no traffic, no process) — drive it from Cloud Scheduler instead, or keep
# --min-instances=1.
REFRESH_CRON_HOUR=3
REFRESH_CRON_MINUTE=15

# Refresh at startup when the snapshot is older than this many hours.
REFRESH_ON_STARTUP=true
REFRESH_IF_STALE_HOURS=24

# --- Regulator endpoints ----------------------------------------------------
# All five verified live 2026-09-09. Regulators do move these; the dashboard
# turns a source red on failure and falls back to a manually downloaded file in
# data/, so a moved URL degrades to "stale" rather than "silently empty".
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.csv
OFAC_CONS_URL=https://www.treasury.gov/ofac/downloads/consolidated/cons_prim.csv
EU_FSF_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/csvFullSanctionsList/content?token=dG9rZW4tMjAxNw
# OFSI's Consolidated List closed 28 Jan 2026; the FCDO list is the single UK source.
UK_OFSI_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.csv
# scsanctions.un.org now 404s; this is the current UN endpoint.
UN_CONSOLIDATED_URL=https://unsolprodfiles.blob.core.windows.net/publiclegacyxmlfiles/EN/consolidated.xml

# --- Calibration ------------------------------------------------------------
# Validate against a known answer set before relying on these.
MATCH_THRESHOLD=85
STRONG_MATCH_THRESHOLD=95
GEO_CONTRADICTION_PENALTY=15
SCREEN_SUBJECT_TYPES=Individual,Entity,Unknown
